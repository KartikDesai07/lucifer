# @pos/hub — owner control plane env (F3). Copy to .env.local (gitignored).
# The Hub runs on its OWN free account + its OWN free M0 "registry" cluster,
# fully decoupled from every cafe runtime (00-architecture-decisions.md §2).

# The registry M0 connection string (the Hub's own cluster — NOT any cafe DB).
HUB_MONGODB_URI=

# The owner account email — seeded as the single `role:'owner'` HubUser
# (npm run seed:hub-user), then enrol TOTP with `npm run enrol:totp`.
HUB_OWNER_EMAIL=

# F3.4 panel auth — Auth.js v5 session signing secret. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Auth.js reads AUTH_SECRET ?? NEXTAUTH_SECRET.) Mark "sensitive" in Vercel.
AUTH_SECRET=

# F3.4 §E-3 IP allowlist — comma-separated IPs/CIDRs the panel accepts for the
# owner. The gate + login FAIL CLOSED on an empty allowlist, so this is REQUIRED
# in prod; `npm run seed:hub-user` reads it. A broad CIDR is fine for a dynamic
# IP; recovery for IP drift is re-running the seed. Example: 203.0.113.7,2001:db8::/48
HUB_OWNER_IP_ALLOWLIST=
# Local-dev / first-boot ONLY: bypass the empty-allowlist lockout. NEVER set in
# prod (it turns the §E-3 wall off). Leave unset in production.
# HUB_ALLOW_ANY_IP=1

# F3.2 vault — the master KEK wrapping every per-record DEK. 32 bytes, base64
# or hex; generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mark "sensitive" in Vercel. NEVER stored in the registry DB; back it up OFFLINE
# (losing it bricks every stored credential). HKDF-split hook: lib/vault-core.ts.
# HUB_KEK is ALWAYS the CURRENT KEK — new records wrap under it.
HUB_KEK=

# F3.3 KEK rotation — the zero-downtime {v1,v2} key map (lib/vault-core.ts).
# HUB_KEK_VERSION = the integer version HUB_KEK is (unset ⇒ 1).
# HUB_KEK_V<n>    = a RETIRED KEK, kept readable only during migration.
# Rotate: set HUB_KEK_V<old>=<old KEK>, HUB_KEK=<new KEK>,
# HUB_KEK_VERSION=<old+1>, redeploy; run rotateKEK until `remaining` is 0;
# then drop HUB_KEK_V<old> from the env. Retire ≠ destroy: keep retired KEKs
# escrowed OFFLINE — a mongodump restore of pre-rotation data needs them.
# NOTE (F3.4): rotateKEK ALSO re-wraps the owner's inline TOTP secret
# (HubUser.totpSecretEnc) and counts it in `remaining`, so `remaining===0` truly
# means the old KEK is retirable (the TOTP secret won't be stranded). If you ever
# drop a KEK the TOTP secret still needs, recover by restoring the escrowed KEK
# and re-running rotateKEK, or re-enrol with `npm run enrol:totp`.
# HUB_KEK_VERSION=
# HUB_KEK_V1=

# F3.7 heartbeat ingest — the platform-wide HMAC key the CF failover Worker
# signs forwarded heartbeats with (scheme: hex HMAC-SHA256 over `${ts}.${body}`,
# @pos/shared/heartbeat). Set the SAME value as the Worker's HUB_INGEST_SECRET
# (`wrangler secret put HUB_INGEST_SECRET` in workers/failover). The ingest
# route FAILS CLOSED (503) while this is unset. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mark "sensitive" in Vercel.
HUB_INGEST_SECRET=

# ── Added by later F3 steps (listed here so setup is discoverable) ──
# F3.5 provisioners — Atlas Admin API service accounts, Vercel token, image store.
#   (ORG-scoped Project-Creator SA for createProject; PROJECT-scoped GROUP_OWNER
#   key for in-project ops — see phase-F3 §2 decision 4.)
# ATLAS_SA_CLIENT_ID=
# ATLAS_SA_CLIENT_SECRET=
# ATLAS_ORG_ID=
# VERCEL_TOKEN=
# F3.12 onboarding — magic-link email (Resend primary, Brevo fallback).
# RESEND_API_KEY=
