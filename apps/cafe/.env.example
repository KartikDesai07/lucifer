# MongoDB Atlas M0 — server-only, never expose to client
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pos?retryWrites=true&w=majority

# NextAuth.js v5 (Auth.js) — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2 — the cafe's OWN bucket; product images (the default store since
# F2.11). Server-only credentials from a bucket-scoped R2 API token.
# The bucket needs a CORS rule allowing PUT + content-type from the app origin
# (see DEPLOY.md) and public read access (r2.dev or a custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional — only when several cafes share one bucket (e.g. tenant/<id>/).
# Leave unset for the normal bucket-per-cafe shape.
R2_KEY_PREFIX=

# R2 public base URL (BUILD-time; inlined into the client bundle to render
# product images): https://pub-<hash>.r2.dev or the bucket's custom domain.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Image store for NEW uploads: r2 (default) | cloudinary. Renders + deletes
# dispatch on each stored ref, so legacy Cloudinary images work either way.
#IMAGE_STORE=cloudinary

# Cloudinary — only for deploys staying on their single per-cafe Cloudinary
# account (IMAGE_STORE=cloudinary), or carrying legacy Cloudinary images.
# Server-only credentials for signed operations / deletes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary — public cloud name (BUILD-time; needed to render legacy Cloudinary
# image refs). Uploads are signed server-side via /api/upload — no public preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Realtime nudges (socket slice 1) — OPTIONAL, OFF BY DEFAULT ──────────────
# A supplement to the existing polls, never a replacement. Leave all three unset
# and the cafe behaves exactly as it does today: the Kitchen board polls every
# 10s and the POS pulse every 20s. Setting them only makes those screens refresh
# EARLY when a write lands.
#
# The Worker lives in the CLIENT'S OWN Cloudflare account (like their Vercel
# account and their Atlas M0) — see workers/realtime/README.md. One deployment
# per cafe, so each cafe gets its own free tier.
#
# NOTE: the nudge envelope carries this deploy's TENANT_ID, and the Worker
# REFUSES (403) any tenant that is not the one it was deployed for. go-live sets
# TENANT_ID for every provisioned cafe, so this is automatic there — but if you
# wire these three by hand, set TENANT_ID too or every publish is silently
# refused (the cafe keeps polling, so nothing breaks; the nudges just never land).
#
# Server-only. Where the cafe POSTs its HMAC-signed nudges.
REALTIME_PUBLISH_URL=
# Server-only. MUST match the Worker's `wrangler secret put
# REALTIME_PUBLISH_SECRET`. Unset => publishing is off (fail-closed).
REALTIME_PUBLISH_SECRET=
# BUILD-time, client-visible, and deliberately NOT a secret: the public
# subscribe endpoint (wss://<worker>/join). A message carries an event KIND and
# nothing else — each device refetches its own authenticated query.
NEXT_PUBLIC_REALTIME_URL=
