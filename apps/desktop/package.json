{
  "name": "pos-desktop",
  "productName": "POS Software by sandbee",
  "version": "1.0.1",
  "author": "sandbee",
  "private": true,
  "description": "Windows desktop shell for the counter PC: loads the cafe's POS web app from one saved address, stays in the tray, starts with Windows, and prints slips silently. Outside the npm workspace (own node_modules); built locally with electron-builder, the installer is hand-copied, never uploaded.",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test src/server-url.test.ts src/store.test.ts src/window-state.test.ts src/desktop-paths.test.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.possoftware.pos-desktop",
    "productName": "POS Software by sandbee",
    "directories": { "buildResources": "resources", "output": "dist" },
    "files": ["out/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "electronLanguages": ["en-US"],
    "compression": "maximum",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "resources/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "POS-Software-Setup-${version}.${ext}",
      "shortcutName": "POS Software by sandbee",
      "include": "resources/installer.nsh"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "eslint": "^9.39.4",
    "globals": "^16.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
