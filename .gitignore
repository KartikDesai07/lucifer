# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root .gitignore — patterns are non-anchored so they apply to every
# workspace (apps/*, packages/*), not just the repo root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-output.txt

# next.js (per-app build output: apps/*/.next)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep secrets out of git, but commit the example (any workspace)
.env
.env.*
!.env.example

# cloudflare worker local state (workers/failover)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel build output / local project link
.vercel

# deploy profiles (per-account targets; may hold tokens) — commit only the example
/deploy.profiles.json

# project-local scratch & planning brain-dump (kept out of the product repo)
/self-tasks/

# per-client onboarding notes — these hold LIVE credentials (Atlas connection
# strings with the client's own DB user/password). This repo is public, so a
# single `git add -A` would publish them. Never commit; the hub vault is the
# only sanctioned credential store.
/clients/

# claude code / ai tooling & internal docs — keep out of the product repo
/.claude/
/.claude-memory/
/CLAUDE.md

# internal build narrative — LOCAL ONLY (owner rule 2026-08-09); opened directly
# in a browser, never published or pushed
/docs/progress-tracker.html

# NOTE: `vercel link` appends `.vercel` and `.env*` here on every run. Both are
# already covered above (`.vercel`, and `.env` + `.env.*` with the deliberate
# `!.env.example` negation) — and a trailing `.env*` would sit AFTER that
# negation and re-ignore the committed example files. Delete the duplicates if
# the CLI adds them again.
