{
  "name": "pos-software",
  "version": "2.0.0",
  "private": true,
  "description": "POS Software v2 — multi-client monorepo (cafe runtime + owner Hub) sharing packages/shared",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/cafe",
    "build": "npm run build --workspace apps/cafe",
    "start": "npm run start --workspace apps/cafe",
    "lint": "npm run lint --workspace apps/cafe",
    "typecheck": "npm run typecheck --workspace apps/cafe",
    "test:hygiene": "node --test scripts/db-hygiene/lib.test.mjs",
    "deploy": "node scripts/deploy.mjs"
  }
}
